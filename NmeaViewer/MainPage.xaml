<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NmeaViewer.MainPage"
             Title="NmeaViewer">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="12" RowSpacing="8">

        <!-- Toolbar -->
        <HorizontalStackLayout Grid.Row="0" Spacing="8">
            <Button x:Name="OpenButton" Text="Open File" Clicked="OnOpenClicked" />
            <Button x:Name="PlayPauseButton" Text="Play" Clicked="OnPlayPauseClicked" />
            <Label Text="Speed:" VerticalOptions="Center" />
            <Picker x:Name="SpeedPicker" WidthRequest="80" SelectedIndexChanged="OnSpeedPickerChanged">
                <Picker.Items>
                    <x:String>0.5x</x:String>
                    <x:String>1x</x:String>
                    <x:String>2x</x:String>
                    <x:String>5x</x:String>
                </Picker.Items>
            </Picker>
            <Label Text="Units:" VerticalOptions="Center" />
            <Picker x:Name="UnitPicker" WidthRequest="90" SelectedIndexChanged="OnUnitPickerChanged">
                <Picker.Items>
                    <x:String>mph</x:String>
                    <x:String>ft/s</x:String>
                    <x:String>m/s</x:String>
                    <x:String>km/h</x:String>
                </Picker.Items>
            </Picker>
            <CheckBox x:Name="SkipCheckBox" CheckedChanged="OnSkipCheckBoxChanged" />
            <Label Text="Skip no-position" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- Timeline -->
        <VerticalStackLayout Grid.Row="1" Spacing="4">
            <GraphicsView x:Name="TimelineView" HeightRequest="16" />
            <Slider x:Name="EpochSlider" Minimum="0" Maximum="0" ValueChanged="OnEpochSliderChanged" />
        </VerticalStackLayout>

        <!-- Map + Sky plot -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <HorizontalStackLayout Grid.Row="0" Spacing="8" Margin="0,0,0,4">
                    <Label Text="Map:" VerticalOptions="Center" />
                    <Picker x:Name="MapStylePicker" WidthRequest="120" SelectedIndexChanged="OnMapStyleChanged">
                        <Picker.Items>
                            <x:String>Street</x:String>
                            <x:String>Satellite</x:String>
                            <x:String>Hybrid</x:String>
                        </Picker.Items>
                    </Picker>
                    <Button Text="Fit Track" Clicked="OnFitTrackClicked" Padding="8,4" />
                </HorizontalStackLayout>
                <Grid Grid.Row="1">
                    <WebView x:Name="MapWebView" />
                    <Label x:Name="FixLabel"
                           Text="Fix: —"
                           BackgroundColor="#AA000000"
                           TextColor="White"
                           Padding="8,4"
                           HorizontalOptions="End"
                           VerticalOptions="Start"
                           Margin="8" />
                </Grid>
            </Grid>
            <Grid Grid.Column="1" RowDefinitions="*,Auto">
                <GraphicsView x:Name="SkyPlotView" />
                <Border x:Name="SatelliteDetailPanel"
                        Grid.Row="1"
                        IsVisible="False"
                        Stroke="Gray"
                        Padding="8"
                        BackgroundColor="#222">
                    <VerticalStackLayout x:Name="SatelliteDetailLayout" Spacing="2" />
                </Border>
            </Grid>
        </Grid>

        <!-- Telemetry + raw (scrollable, fixed height) -->
        <ScrollView Grid.Row="3" MaximumHeightRequest="200">
            <VerticalStackLayout Spacing="8" Padding="0,4">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                    <Label Grid.Row="0" Grid.Column="0" x:Name="TimeLabel" Text="Time: —" LineBreakMode="WordWrap" />
                    <Label Grid.Row="0" Grid.Column="1" x:Name="FixDetailLabel" Text="Fix: —" LineBreakMode="WordWrap" />
                    <Label Grid.Row="1" Grid.Column="0" x:Name="PositionLabel" Text="Position: —" LineBreakMode="WordWrap" />
                    <Label Grid.Row="1" Grid.Column="1" x:Name="SatsLabel" Text="Sats: —" LineBreakMode="WordWrap" />
                    <Label Grid.Row="2" Grid.Column="0" x:Name="SpeedLabel" Text="Speed: —" LineBreakMode="WordWrap" />
                    <Label Grid.Row="2" Grid.Column="1" x:Name="HdopLabel" Text="HDOP: —" LineBreakMode="WordWrap" />
                    <Label Grid.Row="3" Grid.Column="0" x:Name="HeadingLabel" Text="Heading: —" LineBreakMode="WordWrap" />
                    <Label Grid.Row="3" Grid.Column="1" x:Name="AccuracyLabel" Text="Accuracy: —" LineBreakMode="WordWrap" />
                </Grid>
                <BoxView HeightRequest="1" Color="#444" />
                <Label x:Name="RawSentencesLabel"
                       FontFamily="OpenSansRegular"
                       FontSize="11"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
